FROM python:3.13-slim

RUN pip install uv --quiet

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --quiet

COPY database.py ./
COPY api/ api/
COPY tools/ tools/
COPY Agent/ Agent/

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
